# ============================================================
# ChargeQ — Environment Variables
# Copy this to .env.local (never commit .env.local)
# ============================================================

# Supabase — Settings → API
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Sentry — https://sentry.io (create a React project, copy the DSN)
# Leave blank to disable error monitoring in development
VITE_SENTRY_DSN=https://your-key@o0.ingest.sentry.io/0

# ChargeQ Edge Function shared secret — used by the send-sms function to reject
# unauthenticated callers. Generate with: openssl rand -hex 32
# Also set in Supabase: supabase secrets set CHARGEQ_FUNCTION_SECRET=<same value>
VITE_CHARGEQ_FUNCTION_SECRET=your-32-char-hex-secret

# Open Charge Map — https://openchargemap.org/site/develop/api
# This is proxied via Edge Function — never exposed to client
# Set this in Supabase Dashboard → Edge Functions → Secrets
# SUPABASE_SECRET_OCM_API_KEY=your-ocm-key-here

# App
VITE_APP_VERSION=2.6.0
VITE_DEFAULT_SITE_KEY=demo

# Twilio — server-side only, set in Supabase secrets (never here)
# supabase secrets set TWILIO_ACCOUNT_SID=ACxxxxxxxx
# supabase secrets set TWILIO_AUTH_TOKEN=xxxxxxxx
# supabase secrets set TWILIO_PHONE_NUMBER=+61xxxxxxxxx
